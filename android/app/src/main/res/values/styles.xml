<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Biko" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/creme</item>
        <item name="android:statusBarColor">@color/creme</item>
        <item name="android:navigationBarColor">@color/creme</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/gelb</item>
    </style>
    <!-- Durchsichtig: die andere App bleibt dahinter sichtbar, Biko kommt als Karte von unten -->
    <style name="Biko.Fenster">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
