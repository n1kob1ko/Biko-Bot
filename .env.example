# Kopieren nach .env und ausfüllen:  cp .env.example .env
# .env ist in .gitignore UND .cursorignore. Niemals committen oder in einen Chat kopieren.
#
# Freqtrade liest Variablen im Muster FREQTRADE__<SEKTION>__<KEY> und überschreibt damit config.json.

# --- Instanz (nur ändern, wenn mehrere Bots auf einem Server laufen) -------------
# install.sh setzt das mit BIKO_NAME=... selbst. Name des Bots, Ports am Server, Maskottchen.
INSTANZ=biko
API_PORT=8080
APP_PORT=8081
MASKOTTCHEN=biko
MASKOTTCHEN_NAME=Biko

# --- Börse --------------------------------------------------------------------
# Welche Config docker compose startet: config.json (Kraken) oder config.binance.json
BOT_CONFIG=config.json

# --- Modus -------------------------------------------------------------------
# test = Spielgeld (Standard). live = ECHTGELD: erst wenn TODO.md "Vor dem ersten echten Euro"
# abgehakt ist. Danach install.sh nochmal ausführen, es prüft Keys und Telegram und fragt nach.
# Live nutzt eine eigene Datenbank (tradesv3.live.sqlite), getrennt von den Spielgeld-Trades.
BIKO_MODUS=test
# Nur für "docker compose up" ohne install.sh. install.sh setzt den Modus über BIKO_MODUS.
FREQTRADE__DRY_RUN=true

# --- API-Key der Börse (nur für Live nötig; im Dry-Run leer lassen) ------------
# Kraken: Query Funds, Query Open/Closed Orders & Trades, Create & Modify Orders,
#         Cancel/Close Orders. KEIN Withdraw, KEIN Deposit. IP-Whitelist: nur die Server-IP.
# Binance: nur "Enable Reading" + "Enable Spot & Margin Trading" (Margin nicht nutzen),
#          KEIN Withdrawal. "Restrict access to trusted IPs only" mit der VPS-IP.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# --- Telegram ------------------------------------------------------------------
# Token von @BotFather, chat_id z. B. über @userinfobot
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# --- Überwachung (optional) ------------------------------------------------------
# Ping-Adresse von healthchecks.io (kostenlos): meldet sich per E-Mail/App, wenn der ganze
# Server ausfällt. Leer lassen = nur Telegram-Alarm, wenn der Bot hängt.
HEALTHCHECK_URL=

# --- FreqUI / REST-API -----------------------------------------------------------
# Komplett hier definiert, damit keine Platzhalter-Secrets in config.json stehen.
# Port ist in docker-compose.yml nur an 127.0.0.1 gebunden.
# Zufällige Werte erzeugen:  python3 -c "import secrets; print(secrets.token_hex(32))"
FREQTRADE__API_SERVER__ENABLED=true
FREQTRADE__API_SERVER__LISTEN_IP_ADDRESS=0.0.0.0
FREQTRADE__API_SERVER__LISTEN_PORT=8080
FREQTRADE__API_SERVER__VERBOSITY=error
FREQTRADE__API_SERVER__ENABLE_OPENAPI=false
FREQTRADE__API_SERVER__USERNAME=niko
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=
