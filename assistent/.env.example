# Nach .env kopieren und ausfüllen:  cp .env.example .env
# Schlüssel von https://console.anthropic.com (Settings > API Keys). Am besten dort ein Monatslimit setzen.
ANTHROPIC_API_KEY=
# Passwort, das man einmal am Handy eingibt. Lang und nicht erratbar.
APP_PASSWORT=
# Optional: anderes Modell (Standard claude-opus-5-5)
# ASSISTENT_MODELL=claude-opus-5-5
# Optional: Sprachdienst für eine natürliche Stimme und Zuhören auf Deutsch und Chinesisch.
# Schlüssel von https://elevenlabs.io (API Keys). Ohne ihn sprechen und hören die Browser selbst.
# ELEVENLABS_API_KEY=
# Optional: Voice ID einer bestimmten Stimme (leer: die erste Stimme des Kontos) und das Stimm-Modell
# SPRACH_STIMME=
# SPRACH_MODELL=eleven_v4_turbo
